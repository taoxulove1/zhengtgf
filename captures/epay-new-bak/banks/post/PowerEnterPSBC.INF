; INF file for PowerEnterPSBC
[version] 
; version signature (same for both NT and Win95) do not remove
signature="$CHICAGO$"
AdvancedINF=2.0

[Add.Code]
PowerEnterPSBC.ocx=PowerEnterPSBC.ocx
PECSP.dll=PECSP.dll

[PECSP.dll]
file-win32-x86=thiscab
FileVersion=1,0,0,1
destdir=11

[PowerEnterPSBC.ocx]
file-win32-x86=thiscab
FileVersion=2,3,3,40
RegisterServer=yes

[Strings]
Provider="CSII Special For PSBC"

; end of INF file