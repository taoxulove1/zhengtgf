; INF file for PowerEnterNBCB
[version] 
; version signature (same for both NT and Win95) do not remove
signature="$CHICAGO$"
AdvancedINF=2.0

[Add.Code]
PowerEnterNBCB.ocx=PowerEnterNBCB.ocx
PECSP.dll=PECSP.dll

[PECSP.dll]
file-win32-x86=thiscab
FileVersion=1,0,0,1
destdir=11

[PowerEnterNBCB.ocx]
file-win32-x86=thiscab
FileVersion=2,1,0,20
RegisterServer=yes

[Strings]
Provider="CSII Special For NBCB"

; end of INF file