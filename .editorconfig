root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{c,cc,cpp,h,hpp}]
indent_size = 4
# 老代码保留制表符风格，不做强制转换
indent_style = tab

[Makefile]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 120

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.ini]
end_of_line = crlf
